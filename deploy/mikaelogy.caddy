# Import inside the less.rest site block, replacing its existing Mikaelogy route.
log mikaelogy {
	output file /var/log/caddy/mikaelogy-access.json {
		roll_size 10MiB
		roll_keep 5
		roll_keep_for 168h
	}
	format json
}
@outsideMikaelogy not path /robots.txt /mikaelogy /mikaelogy/*
log_skip @outsideMikaelogy

# robots.txt must work at the origin root, independently of other applications.
handle /robots.txt {
	root * /srv/mikaelogy
	header Content-Type "text/plain; charset=utf-8"
	header Cache-Control "public, max-age=300"
	file_server
}

redir /mikaelogy /mikaelogy/ 308
handle /mikaelogy/* {
	route {
		uri strip_prefix /mikaelogy
		root * /srv/mikaelogy
		header +Vary "Accept, User-Agent"

		# Only rewrite when the Markdown counterpart exists. Assets and missing URLs
		# keep their normal behavior; this is a representation choice, not access control.
		@markdownRequest {
			method GET HEAD
			expression `(header_regexp('User-Agent', '(?i)(Claude-User|Claude-SearchBot|ClaudeBot|ChatGPT-User|OAI-SearchBot|GPTBot|PerplexityBot|Perplexity-User)') || header_regexp('Accept', '(?i)(^|,)[ ]*text/markdown[ ]*(;|,|$)')) && !header_regexp('Accept', '(?i)text/markdown[ ]*;[^,]*q=0([.]0*)?([ ]*;[^,]*)?([ ]*,|[ ]*$)')`
		}
		route @markdownRequest {
			uri strip_suffix /index.html
			@markdown file {path}/index.md
			rewrite @markdown {file_match.relative}
		}
		@markdownFile path *.md
		header @markdownFile Content-Type "text/markdown; charset=utf-8"
		file_server
	}
}
